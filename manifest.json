{
  "manifest_version": 3,
  "name": "Canvas Image Replacer",
  "version": "1.0.0",
  "description": "Replaces canvas images on a specific website.",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}